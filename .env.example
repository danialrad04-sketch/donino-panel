# Reference only. The native app does not load .env automatically.
# systemd loads this via EnvironmentFile (see deploy/).
DONINO_DB=/var/lib/donino-panel/donino.db
DONINO_PUBLIC_URL=https://panel.example.com
DONINO_SECURE_COOKIE=true

# Optional PostgreSQL professional mode. Keep credentials out of source control.
# DONINO_DATABASE_URL=postgresql+psycopg://donino:REPLACE_ME@127.0.0.1:5432/donino
# Required to decrypt MFA after restore/migration: back up this file separately.
DONINO_KEY_FILE=/var/lib/donino-panel/master.key
