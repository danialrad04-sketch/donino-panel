[Unit]
Description=Donino Panel API and dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=donino
Group=donino
WorkingDirectory=/opt/donino-panel
EnvironmentFile=/etc/donino/panel.env
ExecStart=/opt/donino-panel/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
StateDirectory=donino-panel
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/donino-panel

[Install]
WantedBy=multi-user.target
