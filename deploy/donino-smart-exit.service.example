# Review paths, account, certificate permissions and domain allowlist first.
# Install only on the explicitly provisioned exit host.
[Unit]
Description=Donino authenticated Smart DNS TLS exit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=donino
Group=donino
WorkingDirectory=/opt/donino-panel/current
ExecStart=/opt/donino-panel/current/.venv/bin/python -m agent.smart_exit run /etc/donino/smart-exit.json
Restart=on-failure
RestartSec=5
MemoryMax=256M
TasksMax=128
LimitNOFILE=1024
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
