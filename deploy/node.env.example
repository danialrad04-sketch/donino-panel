DONINO_PANEL_URL=https://panel.example.com
# Legacy only. After secure enrollment the certificate identity takes precedence.
DONINO_NODE_TOKEN=REPLACE_WITH_THE_ONE_TIME_NODE_TOKEN
DONINO_XRAY=/opt/donino-xray/xray
DONINO_NODE_STATE=/var/lib/donino-node
DONINO_MAX_STALE_SECONDS=120
# Optional custom trust root for the panel's HTTPS server, only for private PKI.
# DONINO_PANEL_CA_FILE=/etc/donino/private-panel-ca.crt
